name = "animemaster-bangumi-auth"
main = "worker.js"
compatibility_date = "2026-04-16"

[[kv_namespaces]]
binding = "BANGUMI_AUTH_KV"
id = "replace_with_your_kv_namespace_id"

# Required secrets:
# wrangler secret put BANGUMI_CLIENT_ID
# wrangler secret put BANGUMI_CLIENT_SECRET
# wrangler secret put BANGUMI_CALLBACK_URL
# wrangler secret put DANDANPLAY_APP_ID
# wrangler secret put DANDANPLAY_APP_SECRET

[[durable_objects.bindings]]
name = "DANDANPLAY_GATEWAY"
class_name = "DandanplayGateway"

[[migrations]]
tag = "dandanplay-v1"
new_sqlite_classes = ["DandanplayGateway"]
